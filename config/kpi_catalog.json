        "TS": "AVG(Target_Speed_BPM)"
      },
      "formula": "(Production_Speed_BPM / NULLIF(Target_Speed_BPM, 0)) * 100",
      "query": "SELECT (AVG(Production_Speed_BPM) / NULLIF(AVG(Target_Speed_BPM),0)) * 100 AS Efficiency_percent FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
