    "Net_Efficiency_percent": {
      "metric": "Net_Efficiency_percent",
      "aliases": [
        "net efficiency",
        "net efficiency %",
        "machine net efficiency"
      ],
      "type": "derived_kpi",
      "from": "production_speed_details_data psd CROSS JOIN LATERAL jsonb_array_elements(psd.production_speed_bpm) AS speed(value) JOIN oee_details_data oee ON psd.machine_id = oee.machine_id AND psd.start_time = oee.start_time",
      "aggregates": {
        "PS": "SUM((speed.value)::numeric)",
        "TS": "SUM(oee.target_speed_bpm)"
      },
      "formula": "(PS / NULLIF(TS,0)) * 100",
      "groupable_by": [
        "psd.machine_id",
        "psd.loop_id",
        "oee.grammage",
        "DATE(psd.start_time)"
      ],
      "filters": [
        "machine_id",
        "loop_id",
        "grammage",
        "date_range"
      ],
      "rounding": 0
    },
    "GSM_vendor_consumption": {
      "metric": "GSM_vendor_consumption",
      "aliases": [
        "vendor gsm usage",
        "vendor weight consumption",
        "gsm vendor weight",
        "vendor material usage"
      ],
      "type": "derived_kpi",
      "table": "gsm_usage_details",
      "aggregates": {
        "SW": "SUM(CASE WHEN weight_type = 'Starting Weight' THEN weight ELSE 0 END)",
        "EW": "SUM(CASE WHEN weight_type = 'Ending Weight' THEN weight ELSE 0 END)"
      },
      "formula": "CASE WHEN (SW - EW) < 0 THEN 0 ELSE (SW - EW) END",
      "query": "SELECT vendor, CASE WHEN (SUM(CASE WHEN weight_type='Starting Weight' THEN weight ELSE 0 END) - SUM(CASE WHEN weight_type='Ending Weight' THEN weight ELSE 0 END)) < 0 THEN 0 ELSE (SUM(CASE WHEN weight_type='Starting Weight' THEN weight ELSE 0 END) - SUM(CASE WHEN weight_type='Ending Weight' THEN weight ELSE 0 END)) END AS GSM_vendor_consumption FROM gsm_usage_details GROUP BY vendor",
      "groupable_by": [
        "vendor",
        "material_description",
        "date",
        "shift"
      ],
      "filters": [
        "vendor",
        "material_description",
        "date_range",
        "shift"
      ],
      "rounding": 2
    },
