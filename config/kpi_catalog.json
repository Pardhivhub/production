      },
      "formula": "((H*60 - DT) / NULLIF((H*60),0)) * 100",
      "query": "SELECT ((SUM(1)*60 - SUM(downtime_mins)) / NULLIF((SUM(1)*60),0)) * 100 AS Availability_percent FROM oee_details_data",
      "groupable_by": [
