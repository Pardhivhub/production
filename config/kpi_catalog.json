    "Quality_percent": {
      "metric": "Quality_percent",
      "aliases": [
        "quality",
        "quality %",
        "machine quality",
        "production quality",
        "good production percent",
        "good chips percent"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "GB": "SUM(good_bags)",
        "FB": "SUM(failed_bags)",
        "OL": "SUM(overlimit_count)"
      },
      "formula": "CASE WHEN GB = 0 THEN 0 ELSE (100 - ((OL + FB) / GB) * 100) END",
      "query": "SELECT CASE WHEN SUM(good_bags)=0 THEN 0 ELSE (100 - ((SUM(overlimit_count)+SUM(failed_bags))/SUM(good_bags))*100) END AS Quality_percent FROM oee_details_data",
      "groupable_by": [
        "machine_id",
