    "MTTR_mins": {
      "metric": "MTTR_mins",
      "aliases": [
        "mttr",
        "mean time to repair",
        "average repair time",
        "repair time per breakdown"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "DT": "SUM(downtime_mins)",
        "JJ": "SUM(jaw_jam_error)",
        "JM": "SUM(jam_error)",
        "FMD": "SUM(fmd_error)",
        "SP": "SUM(splice_error)",
        "DP": "SUM(dump_error)",
        "PC": "SUM(print_check_err)",
        "RM": "SUM(reg_mark_err)"
      },
      "formula": "CASE WHEN (JJ+JM+FMD+SP+DP+PC+RM)=0 THEN 0 ELSE DT / (JJ+JM+FMD+SP+DP+PC+RM) END",
      "query": "SELECT CASE WHEN (SUM(jaw_jam_error)+SUM(jam_error)+SUM(fmd_error)+SUM(splice_error)+SUM(dump_error)+SUM(print_check_err)+SUM(reg_mark_err))=0 THEN 0 ELSE SUM(downtime_mins)/(SUM(jaw_jam_error)+SUM(jam_error)+SUM(fmd_error)+SUM(splice_error)+SUM(dump_error)+SUM(print_check_err)+SUM(reg_mark_err)) END AS MTTR_mins FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "loop_id",
        "grammage",
        "DATE(start_time)"
      ],
      "filters": [
        "machine_id",
        "loop_id",
        "grammage",
        "variant",
        "flavour",
        "date_range"
      ],
      "rounding": 1
    },
    "MTBF_mins": {
      "metric": "MTBF_mins",
      "aliases": [
        "mtbf",
        "mean time between failures",
        "uptime per breakdown",
        "run time per failure"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "RT": "SUM(60 - downtime_mins)",
        "JJ": "SUM(jaw_jam_error)",
        "JM": "SUM(jam_error)",
        "FMD": "SUM(fmd_error)",
        "SP": "SUM(splice_error)",
        "DP": "SUM(dump_error)",
        "PC": "SUM(print_check_err)",
        "RM": "SUM(reg_mark_err)"
      },
      "formula": "CASE WHEN (JJ+JM+FMD+SP+DP+PC+RM)=0 THEN RT ELSE RT / (JJ+JM+FMD+SP+DP+PC+RM) END",
      "query": "SELECT CASE WHEN (SUM(jaw_jam_error)+SUM(jam_error)+SUM(fmd_error)+SUM(splice_error)+SUM(dump_error)+SUM(print_check_err)+SUM(reg_mark_err))=0 THEN SUM(60 - downtime_mins) ELSE SUM(60 - downtime_mins)/(SUM(jaw_jam_error)+SUM(jam_error)+SUM(fmd_error)+SUM(splice_error)+SUM(dump_error)+SUM(print_check_err)+SUM(reg_mark_err)) END AS MTBF_mins FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "loop_id",
        "grammage",
        "DATE(start_time)"
      ],
      "filters": [
        "machine_id",
        "loop_id",
        "grammage",
        "variant",
        "flavour",
        "date_range"
      ],
      "rounding": 1
    },
    "Throughput_kg_per_hr": {
      "metric": "Throughput_kg_per_hr",
      "aliases": [
        "throughput",
        "throughput kg/hr",
        "kg per hour",
        "production throughput"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "TP": "SUM(Production_Speed_BPM * Target_Weight)"
      },
      "formula": "(Production_Speed_BPM * Target_Weight) * 0.06",
      "query": "SELECT SUM(Production_Speed_BPM * Target_Weight) * 0.06 AS Throughput_kg_per_hr FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "loop_id",
        "grammage",
        "DATE(start_time)",
        "DATE_TRUNC('hour', start_time)"
