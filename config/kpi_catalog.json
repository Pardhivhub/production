      "aliases": [
        "performance",
        "performance %",
        "machine performance",
        "machine efficiency",
        "production efficiency"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "H": "SUM(1)",
        "DT": "SUM(downtime_mins)",
        "GB": "SUM(good_bags)",
        "TS": "AVG(target_speed)"
      },
      "formula": "((GB / NULLIF((H*60 - DT),0)) / TS) * 100",
      "query": "SELECT ((SUM(good_bags) / NULLIF((SUM(1)*60 - SUM(downtime_mins)),0)) / AVG(target_speed)) * 100 AS Performance_percent FROM oee_details_data",
      "groupable_by": [
        "machine_id",
