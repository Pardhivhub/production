{
  "formulas": {
    "EGA_percent": {
      "metric": "EGA_percent",
      "aliases": [
        "ega percent",
        "ega %",
        "ega_percentage",
        "ega",
        "excess give away percent",
        "extra give away percent",
        "excess give away %",
        "extra chips given away"
      ],
      "type": "derived_kpi",
      "table": "ega_details_data",
      "aggregates": {
        "TW": "SUM(t_weight)",
        "TPW": "SUM(theoretical_pack_weight)"
      },
      "formula": "((TW - TPW) / NULLIF(TW, 0)) * 100",
      "query": "SELECT ((SUM(t_weight) - SUM(theoretical_pack_weight)) / NULLIF(SUM(t_weight), 0)) * 100 AS ega_percent FROM ega_details_data",
      "groupable_by": [
        "machine_id",
        "grammage",
        "variant",
        "loop_id",
        "DATE(start_time)",
        "DATE_TRUNC('hour', start_time)"
      ],
      "filters": [
        "machine_id",
        "grammage",
        "loop_id",
        "date_range"
      ],
      "rounding": 2
    },
    "OEE_percent": {
      "metric": "OEE_percent",
      "aliases": [
        "oee",
        "oee %",
        "overall equipment effeciency",
        "oee percentage",
        "overall efficiency"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "H": "SUM(1)",
        "DT": "SUM(downtime_mins)",
        "GB": "SUM(good_bags)",
        "FB": "SUM(failed_bags)",
        "OL": "SUM(overlimit_count)",
        "TS": "AVG(target_speed)"
      },
      "formula": "((GB / NULLIF((H*60 - DT),0)) / TS * 100) * ((H*60 - DT) / NULLIF((H*60),0) * 100) * (CASE WHEN GB = 0 THEN 0 ELSE (100 - ((OL + FB) / GB) * 100) END) / 10000",
      "query": "SELECT (((SUM(good_bags) / NULLIF((SUM(1)*60 - SUM(downtime_mins)),0)) / AVG(target_speed) * 100) * ((SUM(1)*60 - SUM(downtime_mins)) / NULLIF((SUM(1)*60),0) * 100) * (CASE WHEN SUM(good_bags)=0 THEN 0 ELSE (100 - ((SUM(overlimit_count)+SUM(failed_bags))/SUM(good_bags))*100) END)) / 10000 AS OEE_percent FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "grammage",
        "loop_id",
        "DATE(start_time)",
        "DATE_TRUNC('hour', start_time)"
      ],
      "filters": [
        "machine_id",
        "loop_id",
        "grammage",
        "variant",
        "flavour",
        "date_range"
      ],
      "rounding": 1
    },
    "Downtime_mins": {
      "metric": "Downtime_mins",
      "aliases": [
        "downtime",
        "downtime minutes",
        "machine downtime",
        "breakdown time",
        "downtime mins"
      ],
      "type": "direct_aggregate_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "DT": "SUM(downtime_mins)"
      },
      "formula": "DT",
      "query": "SELECT SUM(downtime_mins) AS downtime_mins FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "loop_id",
        "grammage",
        "DATE(start_time)",
        "DATE_TRUNC('hour', start_time)"
      ],
      "filters": [
        "machine_id",
        "loop_id",
        "grammage",
        "variant",
        "flavour",
        "date_range"
      ],
      "rounding": 1
    },
    "Total_Production_kg": {
      "metric": "Total_Production_kg",
      "aliases": [
        "total production",
        "production",
        "total output",
        "production kg",
        "good production",
        "total chips produced",
        "good chips produced",
        "machine production"
      ],
      "type": "derived_kpi",
      "table": "oee_details_data",
      "aggregates": {
        "GP": "SUM(good_bags * grammage)"
      },
      "formula": "GP / 1000",
      "query": "SELECT SUM(good_bags * grammage) / 1000 AS total_production_kg FROM oee_details_data",
      "groupable_by": [
        "machine_id",
        "machine_name",
        "loop_id",
        "grammage",
